GEMINI_API_KEY=
# Sarvam AI: Saaras speech-to-text for field voice updates + Bulbul read-back.
# Leave unset to fall back to Gemini audio understanding.
SARVAM_API_KEY=
# Optional overrides (defaults: saaras:v4, bulbul:v3, model's default voice).
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=healthgrid-22146
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_MAPS_API_KEY=

# Optional Firebase Admin override. Leave unset to use Application Default
# Credentials (the attached service account on Cloud Run, or local gcloud ADC).
FIREBASE_SERVICE_ACCOUNT_B64=

# Optional WhatsApp Cloud API delivery. In-app delivery works without these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_DEMO_RECIPIENT=
